{
  "name": "pedalboards-core-service",
  "version": "1.0.0",
  "description": "The REST API of the audio plugins, on Cloudflare Workers and D1",
  "homepage": "https://github.com/AIssoufi/pedalboards/tree/master/pedalboards-core-service#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIssoufi/pedalboards.git",
    "directory": "pedalboards-core-service"
  },
  "bugs": {
    "url": "https://github.com/AIssoufi/pedalboards/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "wrangler d1 migrations apply DB --local && wrangler dev",
    "start:local": "wrangler d1 migrations apply DB --local --env local && wrangler dev --env local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:generate": "node scripts/generate-seed-migration.js",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "check:bundle": "node scripts/check-bundle.js",
    "deploy": "wrangler d1 migrations apply DB --remote --env=\"\" && wrangler deploy --env=\"\"",
    "test": "vitest run"
  },
  "author": {
    "name": "ADAM Issoufi",
    "email": "issoufi.adam@etu.unice.fr",
    "url": "https://aissoufi.github.io/"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
