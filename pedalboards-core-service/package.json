{
  "name": "pedalboards-core-service",
  "version": "1.0.0",
  "description": "Pedalboards-core-service est l'API RESTful de l'application web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "wrangler d1 migrations apply DB --local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:generate": "node scripts/generate-seed-migration.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check:bundle": "node scripts/check-bundle.js",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "vitest run"
  },
  "author": {
    "name": "Issoufi Adam",
    "email": "issoufi.adam@etu.unice.fr",
    "url": "https://aissoufi.github.io/"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
