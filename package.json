{
  "name": "pedalboards",
  "version": "1.0.0",
  "description": "Projet MBDS",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:mongodb": "pnpm --filter pedalboards-core-service mongo:start",
    "start:core-service": "pnpm --filter pedalboards-core-service start:dev",
    "start:frontend": "pnpm --filter pedalboards-frontend start",
    "start:cms": "pnpm --filter pedalboards-cms start",
    "start": "pnpm --workspace-root run --parallel --no-bail \"/^start:(core-service|frontend|cms)$/\"",
    "start:dev": "pnpm --workspace-root run --parallel --no-bail \"/^start:(mongodb|core-service|frontend|cms)$/\"",
    "prepare": "husky",
    "test": "pnpm test:commit-messages && CI=true pnpm --filter pedalboards-frontend --filter pedalboards-cms test",
    "test:commit-messages": "node --test \"tools/commit-messages/**/*.test.mjs\"",
    "build": "pnpm --filter pedalboards-frontend --filter pedalboards-cms build",
    "smoke": "pnpm --filter pedalboards-core-service smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/issoufi/pedalboards.git"
  },
  "keywords": [
    "MBDS",
    "2018",
    "MIAGE"
  ],
  "author": "Issoufi ADAM <issoufi.adam1@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/issoufi/pedalboards/issues"
  },
  "homepage": "https://gitlab.com/issoufi/pedalboards#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "husky": "^9.1.7"
  }
}
