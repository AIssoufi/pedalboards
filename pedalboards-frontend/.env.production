# The production site calls the API on its own origin, where the Worker serves /api/*. The Pages
# preview deployments, on *.pages.dev, call it across origins, which its CORS headers allow. The
# address is set here because the Preview variables of the Pages settings did not reach the build.
VITE_CORE_SERVICE=https://pedalboards.issoufi.fr
# The CMS is not deployed, so its address stays empty and the header hides its link.
VITE_BACKEND=
